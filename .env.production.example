# Required in Vercel Production.
# Do not commit real secret values.

OPENAI_API_KEY=sk-your-production-openai-key
# Leave empty for official OpenAI. Use an OpenAI-compatible endpoint for third-party providers.
OPENAI_BASE_URL=
OPENAI_REALTIME_TRANSPORT=webrtc
REALTIME_RELAY_URL=
REALTIME_RELAY_SHARED_SECRET=
REALTIME_RELAY_ALLOWED_ORIGINS=https://nega-yunana.vercel.app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
APP_BASE_URL=https://nega-yunana.vercel.app
UPLOAD_DIR=/tmp/rokid-uploads
CONFIDENTIAL_MODE_DEFAULT=true

# Optional model overrides.
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# Keep false or unset in production when real OpenAI calls should run.
AI_MOCK_MODE=false

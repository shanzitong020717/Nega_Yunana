# Required in Vercel Production.
# Do not commit real secret values.

DEEPSEEK_API_KEY=sk-your-production-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
OPENAI_REALTIME_TRANSPORT=websocket_relay
REALTIME_RELAY_PROVIDER=gemini_live
REALTIME_RELAY_URL=
REALTIME_RELAY_SHARED_SECRET=
REALTIME_RELAY_ALLOWED_ORIGINS=https://nega-yunana.vercel.app
GEMINI_API_KEY=your-production-gemini-api-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
APP_BASE_URL=https://nega-yunana.vercel.app
UPLOAD_DIR=/tmp/rokid-uploads
CONFIDENTIAL_MODE_DEFAULT=true

# Keep false or unset in production when real AI calls should run.
AI_MOCK_MODE=false
